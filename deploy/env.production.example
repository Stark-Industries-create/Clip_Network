# Clip Network production settings. setup-vps.sh copies this to .env.production and fills in the
# generated secrets. Keep .env.production private (chmod 600) and never commit it.

# --- Domain -----------------------------------------------------------------------------------
# The public address of the app. The API is served under /api on the same domain, and stored
# clips under /clip-network-media.
PUBLIC_APP_URL=https://__APP_DOMAIN__
PUBLIC_API_URL=https://__APP_DOMAIN__
NEXT_PUBLIC_API_BASE_URL=https://__APP_DOMAIN__
# Shown on the Terms and Privacy pages.
NEXT_PUBLIC_LEGAL_EMAIL=__LEGAL_EMAIL__

# --- Secrets (generated) ----------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=__ENCRYPTION_MASTER_KEY__
POSTGRES_USER=clipnetwork
POSTGRES_DB=clipnetwork
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql://clipnetwork:__POSTGRES_PASSWORD__@postgres:5432/clipnetwork

# --- File storage (MinIO in this stack) -------------------------------------------------------
S3_ENDPOINT=https://__APP_DOMAIN__
S3_BUCKET=clip-network-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=__S3_ACCESS_KEY_ID__
S3_SECRET_ACCESS_KEY=__S3_SECRET_ACCESS_KEY__

# --- Worker ------------------------------------------------------------------------------------
SOURCE_AUTOMATION_ENABLED=true
CHANNEL_MONITOR_INTERVAL_MS=300000
WORKER_CONCURRENCY=2
DISCOVERY_CONCURRENCY=4

# --- Entered in the app instead -----------------------------------------------------------------
# Stripe, YouTube/Google, Facebook, Instagram, TikTok, X and Resend keys can be left empty here and
# entered by the platform admin in Control Center > Integrations. Values set here also work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
YOUTUBE_MADE_FOR_KIDS=no

# --- Optional providers ------------------------------------------------------------------------
# Hosted transcription (faster Twitch/Kick analysis) and LLM moment ranking. OpenAI-compatible.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
HIGHLIGHT_LLM_URL=
HIGHLIGHT_LLM_API_KEY=
HIGHLIGHT_LLM_MODEL=

# =============================================================================
# Clip Network Commercial SaaS — Environment Configuration
# =============================================================================
NODE_ENV=development
PORT=4100
PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4100"
# Public origin of the API, for the Stripe webhook URL (production: same as PUBLIC_APP_URL).
PUBLIC_API_URL=""
# Number of reverse proxies in front of the API (production stack: 2, Caddy then nginx).
TRUST_PROXY_HOPS=0
# Contact shown on the Terms and Privacy pages.
NEXT_PUBLIC_LEGAL_EMAIL=""

# Database (SQLite for local dev; PostgreSQL URL for staging/production)
DATABASE_URL="file:./data/clip-network.db"

# Security & Encryption (generate 32+ random bytes in production)
ENCRYPTION_MASTER_KEY="replace-with-strong-32-byte-secret-in-production"
BILLING_WEBHOOK_SECRET="replace-with-strong-hmac-sha256-webhook-secret"

# Stripe Live Billing (optional — falls back to honest SANDBOX_WEBHOOK when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Transactional Email via Resend (optional — falls back to token-redacted SANDBOX_LOG)
RESEND_API_KEY=""
EMAIL_FROM="Clip Network <noreply@clipnetwork.io>"

# Social Publishing via Postiz (optional — falls back to SANDBOX_SIMULATED)
POSTIZ_API_KEY=""
POSTIZ_API_BASE_URL="https://api.postiz.com/public/v1"

# S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO — falls back to LOCAL_SANDBOX)
S3_ENDPOINT=""
S3_BUCKET="clip-network-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Background Channel Monitor Interval (ms, 0 to disable)
CHANNEL_MONITOR_INTERVAL_MS="300000"

# Enable processing of creator-authorized source bundles deposited in private storage.
SOURCE_AUTOMATION_ENABLED=false
# Recording analysis for YouTube, Twitch and Kick on a worker with yt-dlp and whisper
# (whisper-cli, or an FFmpeg build with the whisper filter). YouTube uses the platform's
# captions and whisper only on chosen moments; Twitch and Kick are transcribed from audio.
# Analyze only channels whose owners authorized it.
RECORDING_WHISPER_MODEL=
# Optional hosted Whisper with the OpenAI-compatible /audio/transcriptions API (for example Groq:
# https://api.groq.com/openai/v1 with whisper-large-v3-turbo). Used for Twitch and Kick audio and for
# exact clip edges; local whisper stays the fallback when RECORDING_WHISPER_MODEL is set.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional LLM ranking of viral moments through any OpenAI-compatible /chat/completions endpoint
# (Gemini's OpenAI endpoint, GPT-4o-mini, Groq, OpenRouter, Anthropic's OpenAI-compatible endpoint).
# Transcripts are sent to this provider: cover it in your terms. Rule-based ranking is used without it.
HIGHLIGHT_LLM_URL=
HIGHLIGHT_LLM_API_KEY=
HIGHLIGHT_LLM_MODEL=
# Task slots per worker process (analysis, render, publish). Run more processes to scale out.
WORKER_CONCURRENCY=2
# Workspaces whose channels are listed at the same time during discovery.
DISCOVERY_CONCURRENCY=4
YOUTUBE_SOURCE_PYTHON=python3
YOUTUBE_WHISPER_VAD_MODEL=
# Optional caption model override for a worker running outside the inference image.
CLIP_FINAL_CAPTION_MODEL=
# Optional OpenCV YuNet ONNX model path for per-clip facecam detection.
FACECAM_YUNET_MODEL=
# Automatic posting is a per-workspace setting (Settings > Automation). Set true to stop it everywhere.
AUTO_PUBLISH_DISABLED=false
# Required for YouTube Shorts publishing. Set yes or no for the pilot content.
POSTIZ_YOUTUBE_MADE_FOR_KIDS=

# Optional managed recording connector. Use separate secrets for each direction.
SOURCE_CONNECTOR_WORKSPACE_ID=
SOURCE_CONNECTOR_SUBSCRIPTIONS_URL=
SOURCE_CONNECTOR_ADMIN_TOKEN=
SOURCE_CONNECTOR_INGRESS_TOKEN=

# Instagram hosted authorization uses a dedicated Postiz organization for one pilot workspace.
POSTIZ_INSTAGRAM_WORKSPACE_ID=
POSTIZ_FRONTEND_URL=https://platform.postiz.com

# Direct social OAuth. Register PUBLIC_APP_URL/social-accounts as the redirect URL.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
META_GRAPH_VERSION=v23.0
X_CLIENT_ID=
X_CLIENT_SECRET=
# Sign in with Google; when empty the YouTube OAuth client is reused.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional YouTube Data API key for video statistics (comment counts).
YOUTUBE_API_KEY=
YOUTUBE_MADE_FOR_KIDS=
